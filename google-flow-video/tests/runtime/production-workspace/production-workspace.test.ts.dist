import { mkdtemp, writeFile } from "node:fs/promises";
import { createHash } from "node:crypto";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { describe, expect, it } from "vitest";
import { Storage } from "../../packages/storage/src/index.js";
import { ProductionWorkspace, type ModelPolicy } from "../../packages/production-workspace/src/index.js";

const policy:ModelPolicy={version:1,requiredFamily:"veo",apiCode:null,allowFallback:false,executionBackend:"flow_ui",selectionSource:"explicit",capabilityState:"supported",evidenceDate:"2026-09-12"};
const h=(n:string)=>n.repeat(64).slice(0,64);
async function setup(){const dir=await mkdtemp(join(tmpdir(),"pw-")),refPath=join(dir,"courier.png");await writeFile(refPath,"reference");const path=join(dir,"state.sqlite"),storage=new Storage(path),ws=new ProductionWorkspace(storage),refHash=createHash("sha256").update("reference").digest("hex");const p=ws.createProject({name:"whole film"}),e=ws.createEntity({projectId:p.id,displayName:"courier"}),r=ws.addReferenceVersion({entityId:e.id,sha256:refHash,role:"identity",source:{kind:"local",locator:refPath}});const bind=(key:string,requestHash:string,ledger="parent-200",reserve=true)=>{const job=storage.createOrGet({provider:"mock",idempotencyKey:key,requestHash,requestJson:JSON.stringify({budgetContext:{ledgerId:ledger,stepKey:key}}),finalPromptSha256:h("e")}).job;if(reserve)storage.reserveBudgetStep(ledger,key,1,{jobId:job.id,requestHash});return {jobId:job.id,requestHash,budgetLedgerId:ledger,budgetStepKey:key};};return {path,storage,ws,p,e,r,bind,refPath};}
describe("production workspace",()=>{
 it("persists stable reference scene binding and an existing-job candidate across restart",async()=>{const x=await setup();const s=x.ws.createScenePlan({projectId:x.p.id,ordinal:1,prompt:"arrival",modelPolicy:policy,referenceVersionIds:[x.r.id]});const binding=x.bind("shot-1",h("b"));const c=x.ws.bindExistingJob({sceneId:s.id,...binding});expect(c).toMatchObject({state:"RUNNABLE",budgetLedgerId:"parent-200",jobId:binding.jobId});x.storage.close();const restored=new ProductionWorkspace(new Storage(x.path));expect(restored.candidate(c.id)).toMatchObject({state:"RUNNABLE",requestHash:h("b")});});
 it("refuses a job hash or parent-ledger mismatch instead of creating another budget path",async()=>{const x=await setup();const s=x.ws.createScenePlan({projectId:x.p.id,ordinal:1,prompt:"arrival",modelPolicy:policy,referenceVersionIds:[x.r.id]}),binding=x.bind("shot-1",h("b"));expect(()=>x.ws.bindExistingJob({sceneId:s.id,...binding,requestHash:h("c")})).toThrow("EXISTING_JOB_HASH_MISMATCH");expect(()=>x.ws.bindExistingJob({sceneId:s.id,...binding,budgetLedgerId:"other"})).toThrow("EXISTING_JOB_BUDGET_BINDING_MISMATCH");x.storage.close();});
 it("rejects cycles and cross-project edges",async()=>{const x=await setup();const a=x.ws.createScenePlan({projectId:x.p.id,ordinal:1,prompt:"a",modelPolicy:policy,referenceVersionIds:[x.r.id]}),b=x.ws.createScenePlan({projectId:x.p.id,ordinal:2,prompt:"b",modelPolicy:policy,referenceVersionIds:[x.r.id]});x.ws.addDependency({sceneId:b.id,dependsOnSceneId:a.id});expect(()=>x.ws.addDependency({sceneId:a.id,dependsOnSceneId:b.id})).toThrow("DEPENDENCY_CYCLE");const p2=x.ws.createProject({name:"other"}),o=x.ws.createScenePlan({projectId:p2.id,ordinal:1,prompt:"o",modelPolicy:policy,referenceVersionIds:[]});expect(()=>x.ws.addDependency({sceneId:o.id,dependsOnSceneId:a.id})).toThrow("CROSS_PROJECT_DEPENDENCY");x.storage.close();});
 it("derives revisions and invalidates descendant candidates without deleting bound jobs",async()=>{const x=await setup();const a=x.ws.createScenePlan({projectId:x.p.id,ordinal:1,prompt:"a",modelPolicy:policy,referenceVersionIds:[x.r.id]}),b=x.ws.createScenePlan({projectId:x.p.id,ordinal:2,prompt:"b",modelPolicy:policy,referenceVersionIds:[x.r.id]});x.ws.addDependency({sceneId:b.id,dependsOnSceneId:a.id});const binding=x.bind("b",h("c"));const c=x.ws.planGenerationCandidate({sceneId:b.id,...binding});x.ws.reviseScene({sceneId:a.id,prompt:"a revised"});expect(x.ws.candidate(c.id)).toMatchObject({state:"STALE",jobId:binding.jobId});expect(x.ws.sceneStatus(b.id).blockers.join(" ")).toContain("invalid");x.storage.close();});
 it("blocks a child until its parent current revision has a terminal hashed asset",async()=>{const x=await setup();const a=x.ws.createScenePlan({projectId:x.p.id,ordinal:1,prompt:"a",modelPolicy:policy,referenceVersionIds:[x.r.id]}),b=x.ws.createScenePlan({projectId:x.p.id,ordinal:2,prompt:"b",modelPolicy:policy,referenceVersionIds:[x.r.id]});x.ws.addDependency({sceneId:b.id,dependsOnSceneId:a.id});expect(x.ws.sceneStatus(b.id).state).toBe("BLOCKED");expect(x.ws.sceneStatus(b.id).blockers.join(" ")).toContain("terminal generated asset");x.storage.close();});
 it("keeps bound old asset and receipt hashes after an edit makes the candidate stale",async()=>{const x=await setup(),s=x.ws.createScenePlan({projectId:x.p.id,ordinal:1,prompt:"a",modelPolicy:policy,referenceVersionIds:[x.r.id]}),binding=x.bind("old",h("f"));x.storage.db.prepare("INSERT INTO assets(provider_asset_ref,job_id,payload_json,sha256,created_at) VALUES(?,?,?,?,?)").run("asset-old",binding.jobId,"{}",h("a"),new Date().toISOString());x.storage.db.prepare("INSERT INTO browser_execution_tickets(id,job_id,attempt_id,action,status,browser_id,tab_id,project_ref,request_hash,snapshot_json,issued_at,receipt_json) VALUES(?,?,?,?,?,?,?,?,?,?,?,?)").run("ticket-old",binding.jobId,"attempt-old","RECONCILE","RECEIPTED","b","t","p",binding.requestHash,"{}",new Date().toISOString(),'{"outcome":"reconciled"}');const c=x.ws.bindExistingJob({sceneId:s.id,...binding});expect(c.jobEvidence.assetHashes).toEqual([{providerAssetRef:"asset-old",sha256:h("a")}]);expect(c.jobEvidence.receiptHashes).toHaveLength(1);x.ws.reviseScene({sceneId:s.id,prompt:"changed"});expect(x.ws.candidate(c.id)).toMatchObject({state:"STALE",jobEvidence:c.jobEvidence});x.storage.close();});
 it("rechecks changed local references before dispatch and builds a frozen edit input contract",async()=>{const x=await setup();const s=x.ws.createScenePlan({projectId:x.p.id,ordinal:1,prompt:"edit",modelPolicy:{...policy,requiredFamily:"gemini_omni_flash_1_1",apiCode:null},referenceVersionIds:[x.r.id]});await writeFile(x.refPath,"changed");expect(()=>x.ws.buildExternalRequest({sceneId:s.id,idempotencyKey:"edit-1",project:{name:"p"},mode:"edit_video",sourceVideo:{path:x.refPath},aspectRatio:"16:9",durationSeconds:4,resolution:"720p",outputs:1,budgetLedgerId:"parent",budgetStepKey:"edit"})).toThrow("REFERENCE_HASH_MISMATCH");x.storage.close();});
 it("builds an immutable Omni edit_video input without claiming browser execution",async()=>{const x=await setup();const s=x.ws.createScenePlan({projectId:x.p.id,ordinal:1,prompt:"edit",modelPolicy:{...policy,requiredFamily:"gemini_omni_flash_1_1",apiCode:null,capabilityState:"unknown"},referenceVersionIds:[x.r.id]});const request=x.ws.buildExternalRequest({sceneId:s.id,idempotencyKey:"edit-1",project:{name:"p"},mode:"edit_video",sourceVideo:{path:x.refPath},aspectRatio:"16:9",durationSeconds:4,resolution:"720p",outputs:1,budgetLedgerId:"parent",budgetStepKey:"edit"});expect(request).toMatchObject({mode:"edit_video",inputs:{source_video:{path:x.refPath}},workspace:{flow_ui_edit_unverified:true}});x.storage.close();});
 it("fails closed for unsupported Omni policy",async()=>{const x=await setup();const s=x.ws.createScenePlan({projectId:x.p.id,ordinal:1,prompt:"omni",modelPolicy:{version:1,requiredFamily:"gemini_omni_flash_1_1",apiCode:null,allowFallback:false,executionBackend:"flow_ui",selectionSource:"default",capabilityState:"unsupported",unsupportedReason:"unsupported on current supported Flow UI route"},referenceVersionIds:[x.r.id]});const c=x.ws.planGenerationCandidate({sceneId:s.id,...x.bind("o",h("d"),"p")});expect(c.state).toBe("UNSUPPORTED");expect(c.nextSafeOperation).toContain("Observe");x.storage.close();});
});
