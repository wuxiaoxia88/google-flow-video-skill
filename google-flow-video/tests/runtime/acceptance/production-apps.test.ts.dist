import { execFile, spawn } from "node:child_process";
import { createHash } from "node:crypto";
import { mkdtemp, readFile, writeFile } from "node:fs/promises";
import { createServer } from "node:net";
import { tmpdir } from "node:os";
import { join, resolve } from "node:path";
import { promisify } from "node:util";
import { afterEach, describe, expect, it, vi } from "vitest";
import { Storage } from "../../packages/storage/src/index.js";
import { chromium } from "playwright";

const runFile=promisify(execFile),root=resolve(import.meta.dirname,"../.."),tsx=resolve(root,"node_modules/.bin/tsx"),children:Array<ReturnType<typeof spawn>>=[];
vi.setConfig({testTimeout:15_000});
afterEach(()=>children.splice(0).forEach(child=>child.kill("SIGTERM")));
async function cli(db:string,args:string[]){const result=await runFile(tsx,["apps/flowctl/src/index.ts",...args],{cwd:root,env:{...process.env,FLOWBRIDGE_DB_PATH:db}});return JSON.parse(result.stdout);}
async function port(){return await new Promise<number>((ok,no)=>{const server=createServer();server.once("error",no);server.listen(0,"127.0.0.1",()=>{const address=server.address();if(!address||typeof address==="string")return no(new Error("no port"));server.close(error=>error?no(error):ok(address.port));});});}
async function daemon(db:string){const p=await port(),dir=await mkdtemp(join(tmpdir(),"flowd-dashboard-")),tokenPath=join(dir,"token"),child=spawn(tsx,["apps/flowd/src/index.ts"],{cwd:root,env:{...process.env,FLOWBRIDGE_DB_PATH:db,FLOWBRIDGE_TOKEN_PATH:tokenPath,FLOWBRIDGE_PORT:String(p)},stdio:["ignore","pipe","pipe"]});children.push(child);await new Promise<void>((ok,no)=>{let err="";child.stderr.on("data",x=>err+=x);const timer=setTimeout(()=>no(new Error(err||"timeout")),5000);child.stdout.once("data",()=>{clearTimeout(timer);ok();});});return {p,token:(await readFile(tokenPath,"utf8")).trim()};}

describe("production workspace apps",()=>{
  it("exports a scene into an engine-created immutable job without running it",async()=>{const dir=await mkdtemp(join(tmpdir(),"flowctl-workspace-")),db=join(dir,"db.sqlite"),asset=join(dir,"courier.png"),bytes=Buffer.from("frozen fixture");await writeFile(asset,bytes);const project=await cli(db,["workspace","project","add","--name","local film"]),entity=await cli(db,["workspace","entity","add","--project",project.id,"--name","courier"]),reference=await cli(db,["workspace","entity","revise","--entity",entity.id,"--sha256",createHash("sha256").update(bytes).digest("hex"),"--role","identity","--source-kind","local","--locator",asset]),scene=await cli(db,["workspace","scene","plan","--project",project.id,"--ordinal","1","--prompt","arrive","--references",reference.id]),status=await cli(db,["workspace","scene","status","--scene",scene.id]);expect(status).toMatchObject({state:"BLOCKED"});const observation=join(dir,"observation.json");await writeFile(observation,JSON.stringify({browserId:"fixture-browser",tabId:"fixture-tab",url:"https://flow.google.com/project/fixture",projectRef:"https://flow.google.com/project/fixture",observedAt:new Date().toISOString(),configuration:{model:"Gemini Omni Flash 1.1",mode:"text_to_video",aspectRatio:"16:9",durationSeconds:4,resolution:"720p",outputs:1},totalCredits:4,availableCredits:200,visibleAccountContext:`account-sha256:${"a".repeat(64)}`,visibleAssetRefs:[]}));await cli(db,["workspace","scene","revise","--scene",scene.id,"--capability-observation",observation]);const requestPath=join(dir,"request.json"),exported=await cli(db,["workspace","scene","export-request","--scene",scene.id,"--idempotency-key","scene-export-1","--project-name","https://flow.google.com/project/fixture","--mode","text_to_video","--aspect-ratio","16:9","--duration-seconds","4","--resolution","720p","--outputs","1","--budget-ledger","film-200","--budget-step","shot-01","--out",requestPath]);expect(exported.candidate).toMatchObject({jobId:exported.job.id,state:"RUNNABLE"});const frozen=JSON.parse(await readFile(requestPath,"utf8"));expect(frozen).toMatchObject({cost_policy:{max_credits:200},workspace:{scene_id:scene.id}});const check=new Storage(db);expect(check.getJob(exported.job.id)?.state).toBe("VALIDATING");expect(check.getIntent(exported.job.id)).toBeNull();check.close();});
  it("renders escaped read-only data and returns a sanitized token-protected snapshot",async()=>{const dir=await mkdtemp(join(tmpdir(),"flowd-workspace-")),db=join(dir,"db.sqlite"),project=await cli(db,["workspace","project","add","--name","safe local film"]),sceneId='<img src=x onerror="globalThis.pwned=1">';await cli(db,["workspace","scene","plan","--project",project.id,"--id",sceneId,"--ordinal","1","--prompt","private prompt private@example.com never rendered"]);const x=await daemon(db),response=await fetch(`http://127.0.0.1:${x.p}/dashboard/`);expect(response.status).toBe(200);expect(await response.text()).toContain("FlowBridge 操作面板");expect((await fetch(`http://127.0.0.1:${x.p}/v1/production/projects/${project.id}/dashboard`)).status).toBe(401);const snapshot=await (await fetch(`http://127.0.0.1:${x.p}/v1/production/projects/${project.id}/dashboard`,{headers:{authorization:`Bearer ${x.token}`}})).json() as any,encoded=JSON.stringify(snapshot);expect(snapshot.scenes).toHaveLength(1);expect(encoded).not.toContain("private prompt");expect(encoded).not.toMatch(/account|browserId|tabId|@/);const browser=await chromium.launch({headless:true});try{const page=await browser.newPage();await page.goto(`http://127.0.0.1:${x.p}/dashboard/`);await page.locator("#token").fill(x.token);await page.locator("#project").fill(project.id);await page.locator("button").click();await expect.poll(()=>page.locator("#scene-list article").count()).toBe(1);expect(await page.locator("#scene-list img").count()).toBe(0);expect(await page.evaluate(()=>Boolean((globalThis as any).pwned))).toBe(false);expect(await page.locator("body").innerText()).not.toContain("private prompt");}finally{await browser.close();}});
  it("prepares edit_video offline and leaves browser verification pending",async()=>{
    const dir=await mkdtemp(join(tmpdir(),"flowctl-edit-")),db=join(dir,"db.sqlite"),source=join(dir,"source.mp4");await writeFile(source,Buffer.from("offline source fixture"));
    const project=await cli(db,["workspace","project","add","--name","edit film"]),scene=await cli(db,["workspace","scene","plan","--project",project.id,"--ordinal","1","--prompt","change the weather"]),observation=join(dir,"edit-observation.json");
    await writeFile(observation,JSON.stringify({browserId:"fixture-browser",tabId:"fixture-tab",url:"https://flow.google.com/project/edit",projectRef:"https://flow.google.com/project/edit",observedAt:new Date().toISOString(),configuration:{model:"Gemini Omni Flash 1.1",mode:"edit_video",aspectRatio:"16:9",durationSeconds:4,resolution:"720p",outputs:1},totalCredits:4,availableCredits:200,visibleAccountContext:`account-sha256:${"b".repeat(64)}`,visibleAssetRefs:[]}));
    await cli(db,["workspace","scene","revise","--scene",scene.id,"--capability-observation",observation]);const out=join(dir,"edit-request.json"),result=await cli(db,["workspace","scene","export-request","--scene",scene.id,"--idempotency-key","edit-1","--project-name","https://flow.google.com/project/edit","--mode","edit_video","--source-video",source,"--aspect-ratio","16:9","--duration-seconds","4","--resolution","720p","--outputs","1","--budget-ledger","edit-200","--budget-step","edit-01","--out",out]);
    expect(result.contractStatus).toBe("TICKET_CONTRACT_PREPARED_BROWSER_UNVERIFIED");const request=JSON.parse(await readFile(out,"utf8"));expect(request.workspace.flow_ui_edit_unverified).toBe(true);expect(request.inputs.source_video.content_sha256).toMatch(/^[a-f0-9]{64}$/);const storage=new Storage(db);expect(storage.getIntent(result.job.id)).toBeNull();storage.close();
  });
});
