import { createHash } from "node:crypto";
import { mkdtemp, writeFile } from "node:fs/promises";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { describe, expect, it } from "vitest";
import type { ExistingBrowserObservation, VideoGenerationRequest } from "../../packages/contracts/src/index.js";
import { JobEngine } from "../../packages/job-engine/src/index.js";
import { Storage } from "../../packages/storage/src/index.js";
import Database from "better-sqlite3";

const account=`account-sha256:${"a".repeat(64)}`;
const obs=(overrides:Partial<ExistingBrowserObservation>={}):ExistingBrowserObservation=>({browserId:"browser",tabId:"tab",url:"https://flow.google.com/project/p",projectRef:"https://flow.google.com/project/p",observedAt:new Date().toISOString(),configuration:{model:"veo-3.1-lite",modelOption:{label:"Veo 3.1 Lite",value:"veo-3.1-lite"},mode:"text_to_video",aspectRatio:"16:9",durationSeconds:8,resolution:"720p",outputs:1},capabilityCapture:{hash:`sha256:${"a".repeat(64)}`,capturedAt:new Date().toISOString(),locale:"en-US",modelOptions:[{label:"Veo 3.1 Lite",value:"veo-3.1-lite"}]},totalCredits:10,availableCredits:1015,visibleAccountContext:account,visibleAssetRefs:[],...overrides});
const req=(dir:string):VideoGenerationRequest=>({provider:"flow_ui",idempotencyKey:"same-key",project:{name:"https://flow.google.com/project/p",reuse:true},mode:"text_to_video",prompt:"same prompt",promptMode:"verbatim",model:"veo-3.1-lite",modelPolicy:{version:1,requiredFamily:"veo",apiCode:null,allowFallback:false,executionBackend:"flow_ui",selectionSource:"explicit"},aspectRatio:"16:9",durationSeconds:8,resolution:"720p",outputs:1,download:{enabled:true,directory:dir},costPolicy:{maxCredits:50,confirmAbove:50,rejectWhenUnknown:true},authorizationContext:{source:"current_conversation",explicitlyRequestedGeneration:true},budgetContext:{ledgerId:"run",stepKey:"step01"}});
async function fixture(){const dir=await mkdtemp(join(tmpdir(),"flow-failure-")),storage=new Storage(join(dir,"db.sqlite")),engine=new JobEngine(storage,new Map()),job=await engine.create(req(dir)),o=obs(),g=engine.prepareExistingBrowser(job.id,o);engine.claimExistingBrowser(g.ticketId,o);engine.receiptExistingBrowser(g.ticketId,"clicked");const failedPage=obs({configuration:null,totalCredits:null}),r=engine.prepareExistingBrowser(job.id,failedPage);engine.claimExistingBrowser(r.ticketId,obs({configuration:null,totalCredits:null}));return{dir,storage,engine,job,reconcile:r};}
async function evidence(x:Awaited<ReturnType<typeof fixture>>,overrides:Record<string,unknown>={}){const source={executor:"codex_cua",providerStatus:"failed",providerMessage:"Audio generation failed. You have not been charged for this generation.",providerAssetRefs:[],nativeDownload:null,retryClicked:false};const path=join(x.dir,"failure.json"),bytes=Buffer.from(JSON.stringify(source));await writeFile(path,bytes);return{projectRef:"https://flow.google.com/project/p",observedAt:new Date().toISOString(),providerStatus:"failed" as const,providerMessage:source.providerMessage,beforeAssetRefs:[],currentAssetRefs:[],charged:"not_charged" as const,balanceBefore:1015,balanceAfter:1015,sourceEvidencePath:path,sourceEvidenceSha256:createHash("sha256").update(bytes).digest("hex"),...overrides};}

describe("guarded provider failure and controlled retry",()=>{
 it("confirms one output-free no-charge failure and reserves retry as a separate 10-credit step",async()=>{const x=await fixture();try{const failed=await x.engine.failExistingBrowser(x.reconcile.ticketId,await evidence(x));expect(failed).toMatchObject({state:"FAILED",errorCode:"PROVIDER_FAILURE"});expect(x.storage.getLatestAttempt(x.job.id)).toMatchObject({ordinal:1,attempt_status:"FAILED"});expect(x.storage.getBudgetLedger("run")).toMatchObject({reservedCredits:10,consumedCredits:10});const retry=x.engine.prepareControlledRetry(x.job.id,obs());expect(retry).toMatchObject({action:"GENERATE"});expect(x.storage.getIntent(x.job.id)).toMatchObject({ordinal:2,attempt_status:"ACTIVE"});expect(x.storage.getBudgetLedger("run")).toMatchObject({reservedCredits:20,consumedCredits:10});x.engine.claimExistingBrowser(retry.ticketId,obs());x.engine.receiptExistingBrowser(retry.ticketId,"clicked");expect(x.storage.getBudgetLedger("run")).toMatchObject({reservedCredits:20,consumedCredits:20});const released=await x.engine.confirmNoCharge(x.job.id,(x.storage.db.prepare("select id from submission_attempts where job_id=? and ordinal=1").get(x.job.id) as any).id);expect(released).toMatchObject({releasedCredits:10,idempotent:false,ledger:{reservedCredits:10,consumedCredits:10}});expect(await x.engine.confirmNoCharge(x.job.id,(x.storage.db.prepare("select id from submission_attempts where job_id=? and ordinal=1").get(x.job.id) as any).id)).toMatchObject({releasedCredits:10,idempotent:true,ledger:{reservedCredits:10,consumedCredits:10}});await expect(x.engine.confirmNoCharge(x.job.id,x.storage.getIntent(x.job.id)!.id)).rejects.toThrow(/original|failed/i);expect(()=>x.engine.prepareControlledRetry(x.job.id,obs())).toThrow(/failed|attempt|retry/i);expect((x.storage.db.prepare("select count(*) n from submission_attempts where job_id=?").get(x.job.id) as any).n).toBe(2);}finally{x.storage.close();}});
 it("rejects unknown charge, changed balance, output refs, and tampered source without consuming the failure ticket",async()=>{for(const patch of [{charged:"unknown"},{balanceAfter:1005},{currentAssetRefs:["card"]},{sourceEvidenceSha256:"0".repeat(64)}]){const x=await fixture();try{await expect(x.engine.failExistingBrowser(x.reconcile.ticketId,await evidence(x,patch))).rejects.toThrow();expect(x.engine.get(x.job.id).state).toBe("GENERATING");expect(x.storage.getBrowserTicket(x.reconcile.ticketId)?.status).toBe("CLAIMED");expect(x.storage.getLatestAttempt(x.job.id)).toMatchObject({attempt_status:"ACTIVE"});}finally{x.storage.close();}}});
 it("refuses no-charge release when stored balance proof changes after failure",async()=>{const x=await fixture();try{await x.engine.failExistingBrowser(x.reconcile.ticketId,await evidence(x));const row=x.storage.db.prepare("select receipt_json from browser_execution_tickets where id=?").get(x.reconcile.ticketId) as any,receipt=JSON.parse(row.receipt_json);receipt.evidence.balanceAfter=1005;x.storage.db.prepare("update browser_execution_tickets set receipt_json=? where id=?").run(JSON.stringify(receipt),x.reconcile.ticketId);const attempt=(x.storage.db.prepare("select id from submission_attempts where job_id=? and ordinal=1").get(x.job.id) as any).id;await expect(x.engine.confirmNoCharge(x.job.id,attempt)).rejects.toThrow(/balance|proof/i);expect(x.storage.getBudgetStep("run","step01")?.state).toBe("CONSUMED");expect(x.storage.getBudgetLedger("run")).toMatchObject({reservedCredits:10,consumedCredits:10});}finally{x.storage.close();}});
 it("migrates a v1 unique-job attempt without breaking an attestation foreign key",async()=>{const dir=await mkdtemp(join(tmpdir(),"flow-attempt-migrate-")),path=join(dir,"old.sqlite"),db=new Database(path);db.pragma("foreign_keys=ON");db.exec(`CREATE TABLE jobs(id TEXT PRIMARY KEY);CREATE TABLE submission_attempts(id TEXT PRIMARY KEY,job_id TEXT NOT NULL UNIQUE,fencing_token TEXT NOT NULL,request_hash TEXT NOT NULL,snapshot_json TEXT NOT NULL,intent_recorded_at TEXT NOT NULL,evidence_json TEXT,FOREIGN KEY(job_id) REFERENCES jobs(id));CREATE TABLE browser_baseline_attestations(attempt_id TEXT PRIMARY KEY,job_id TEXT NOT NULL,request_hash TEXT NOT NULL,project_ref TEXT NOT NULL,browser_id TEXT NOT NULL,tab_id TEXT NOT NULL,captured_at TEXT NOT NULL,source_observation_path TEXT NOT NULL,source_observation_sha256 TEXT NOT NULL,baseline_asset_refs_json TEXT NOT NULL,attested_at TEXT NOT NULL,reason TEXT NOT NULL CHECK(reason='legacy_mapping_defect'),FOREIGN KEY(job_id) REFERENCES jobs(id),FOREIGN KEY(attempt_id) REFERENCES submission_attempts(id));INSERT INTO jobs VALUES('j');INSERT INTO submission_attempts VALUES('a','j','f','h','{}','2026-01-01T00:00:00Z',NULL);INSERT INTO browser_baseline_attestations VALUES('a','j','h','p','b','t','2026-01-01T00:00:00Z','x','${"0".repeat(64)}','[]','2026-01-01T00:00:00Z','legacy_mapping_defect');`);db.close();const migrated=new Storage(path);try{expect(migrated.db.prepare("pragma foreign_key_check").all()).toEqual([]);expect(migrated.db.prepare("select ordinal,attempt_status from submission_attempts where id='a'").get()).toEqual({ordinal:1,attempt_status:"ACTIVE"});expect(migrated.db.prepare("select count(*) n from browser_baseline_attestations").get()).toEqual({n:1});}finally{migrated.close();}});
});
