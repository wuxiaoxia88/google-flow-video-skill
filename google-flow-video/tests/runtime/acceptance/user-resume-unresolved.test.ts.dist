import { createHash } from "node:crypto";
import { mkdtemp, writeFile } from "node:fs/promises";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { describe,expect,it } from "vitest";
import type { ExistingBrowserObservation,VideoGenerationRequest } from "../../packages/contracts/src/index.js";
import { JobEngine } from "../../packages/job-engine/src/index.js";
import { Storage } from "../../packages/storage/src/index.js";
const acct=`account-sha256:${"a".repeat(64)}`,project="https://flow.google.com/project/p",baseline=["parent-ref","frame.png"];
const observation=(tab="old",credits=10):ExistingBrowserObservation=>({browserId:"browser1",tabId:tab,url:project,projectRef:project,observedAt:new Date().toISOString(),configuration:{model:"veo-3.1-lite",mode:"text_to_video",aspectRatio:"16:9",durationSeconds:8,resolution:"720p",outputs:1},availableCredits:100,totalCredits:credits,visibleAccountContext:acct,visibleAssetRefs:baseline});
const request=(dir:string):VideoGenerationRequest=>({provider:"flow_ui",idempotencyKey:"same-key",project:{name:project,reuse:true},mode:"text_to_video",prompt:"p",promptMode:"verbatim",model:"veo-3.1-lite",aspectRatio:"16:9",durationSeconds:8,resolution:"720p",outputs:1,download:{enabled:true,directory:dir},costPolicy:{maxCredits:50,confirmAbove:50,rejectWhenUnknown:true},authorizationContext:{source:"current_conversation",explicitlyRequestedGeneration:true},budgetContext:{ledgerId:"run",stepKey:"step02"}});
async function setup(){const dir=await mkdtemp(join(tmpdir(),"user-resume-")),storage=new Storage(join(dir,"db.sqlite")),engine=new JobEngine(storage,new Map()),job=await engine.create(request(dir)),old=observation(),ticket=engine.prepareExistingBrowser(job.id,old);engine.claimExistingBrowser(ticket.ticketId,old);engine.receiptExistingBrowser(ticket.ticketId,"clicked");storage.reserveBudgetStep("run","prior",10,{jobId:"prior",requestHash:"prior"});storage.consumeBudgetStep("run","prior");const fresh=observation("new"),source={activeGenerationVisible:false,terminalStatusVisible:false,observedAt:fresh.observedAt,jobId:job.id,idempotencyKey:job.idempotencyKey,projectRef:project,browserId:"browser1",tabId:"new",visibleAccountContext:acct,availableCredits:100,totalCredits:10,configuration:fresh.configuration,baselineAssetRefs:baseline,currentAssetRefs:baseline,newAssetRefs:[],providerStatus:"unknown",providerMessage:"No active card or terminal result"},sourcePath=join(dir,"source.json"),sourceBytes=Buffer.from(JSON.stringify(source));await writeFile(sourcePath,sourceBytes);const proof={...source,activeGenerationVisible:false,terminalStatusVisible:false,sourceProofPath:sourcePath,sourceProofSha256:createHash("sha256").update(sourceBytes).digest("hex")},proofPath=join(dir,"proof.json"),proofBytes=Buffer.from(JSON.stringify(proof));await writeFile(proofPath,proofBytes);const original=storage.getLatestAttempt(job.id)!,authorizedAt=new Date(),auth={kind:"current_user_resume_authorization",version:1,authorizationId:"authorization-fixture-0001",actor:"current_user",decision:"approve_one_additional_paid_attempt",authorizedAt:authorizedAt.toISOString(),expiresAt:new Date(authorizedAt.getTime()+60_000).toISOString(),jobId:job.id,requestHash:job.requestHash,proofSha256:createHash("sha256").update(proofBytes).digest("hex"),budgetLedgerId:"run",budgetStepKey:"step02-retry1",originalAttemptId:original.id,originalFencingToken:original.fencing_token,maxParentCredits:50,maxRetryCredits:10,minRemainingCredits:20,maxAttemptOrdinal:2,sessionContext:{browserId:"browser1",projectRef:project,visibleAccountContext:acct}},authPath=join(dir,"auth.json");await writeFile(authPath,JSON.stringify(auth));return{dir,storage,engine,job,fresh,proofPath,authPath,auth};}
describe("current-user resume of one unresolved effect",()=>{
 it("keeps attempt 1 unresolved and atomically creates only attempt 2 with 20 credits left",async()=>{const x=await setup();try{const t=await x.engine.prepareUserResumeRetry(x.job.id,x.fresh,x.proofPath,x.authPath);expect(t).toMatchObject({action:"GENERATE",browserId:"browser1",tabId:"new"});const a=x.storage.db.prepare("select ordinal,attempt_status,evidence_json from submission_attempts where job_id=? order by ordinal").all(x.job.id) as any[];expect(a.map(v=>[v.ordinal,v.attempt_status])).toEqual([[1,"UNRESOLVED"],[2,"ACTIVE"]]);expect(a[0].evidence_json).toContain("clicked");expect(x.storage.getBudgetLedger("run")).toMatchObject({reservedCredits:30,consumedCredits:20});expect(x.storage.getBudgetStep("run","step02-retry1")).toMatchObject({quotedCredits:10,state:"RESERVED"});expect(()=>x.engine.prepareExistingBrowser(x.job.id,x.fresh)).not.toThrow();await expect(x.engine.prepareUserResumeRetry(x.job.id,x.fresh,x.proofPath,x.authPath)).rejects.toThrow();}finally{x.storage.close();}});
 it("rejects invalid authorization, another browser, active generation, and existing output without mutation",async()=>{for(const kind of ["auth-proof","auth-request","auth-attempt","auth-fence","auth-budget","auth-expired","browser","observation-asset","active","source-active","asset"]){const x=await setup();try{let fresh=x.fresh,proof=x.proofPath,auth=x.authPath;if(kind.startsWith("auth-")){const bad=structuredClone(x.auth) as any;if(kind==="auth-proof")bad.proofSha256="0".repeat(64);if(kind==="auth-request")bad.requestHash="f".repeat(64);if(kind==="auth-attempt")bad.originalAttemptId="attempt-fixture-other";if(kind==="auth-fence")bad.originalFencingToken="fence-fixture-other";if(kind==="auth-budget")bad.budgetStepKey="step-unrelated";if(kind==="auth-expired")bad.expiresAt=new Date(Date.now()-1).toISOString();auth=join(x.dir,`bad-${kind}.json`);await writeFile(auth,JSON.stringify(bad));}if(kind==="browser")fresh={...fresh,browserId:"browser2"};if(kind==="observation-asset")fresh={...fresh,visibleAssetRefs:[...baseline,"new"]};if(kind==="active"){const p=JSON.parse(await (await import("node:fs/promises")).readFile(proof,"utf8"));p.activeGenerationVisible=true;proof=join(x.dir,"active.json");await writeFile(proof,JSON.stringify(p));}if(kind==="source-active"){const p=JSON.parse(await (await import("node:fs/promises")).readFile(proof,"utf8")),src=JSON.parse(await (await import("node:fs/promises")).readFile(p.sourceProofPath,"utf8"));src.activeGenerationVisible=true;const sp=join(x.dir,"source-active.json"),bytes=Buffer.from(JSON.stringify(src));await writeFile(sp,bytes);p.sourceProofPath=sp;p.sourceProofSha256=createHash("sha256").update(bytes).digest("hex");proof=join(x.dir,"source-active-proof.json");await writeFile(proof,JSON.stringify(p));}if(kind==="asset")x.storage.saveAssets(x.job.id,[{providerAssetRef:"new",status:"generated"}]);await expect(x.engine.prepareUserResumeRetry(x.job.id,fresh,proof,auth)).rejects.toThrow();expect((x.storage.db.prepare("select count(*) n from submission_attempts where job_id=?").get(x.job.id) as any).n).toBe(1);expect(x.storage.getBudgetStep("run","step02-retry1")).toBeNull();}finally{x.storage.close();}}});
 it("blocks final price drift before claim and never permits attempt 3",async()=>{const x=await setup();try{const t=await x.engine.prepareUserResumeRetry(x.job.id,x.fresh,x.proofPath,x.authPath);expect(()=>x.engine.claimExistingBrowser(t.ticketId,observation("new",11))).toThrow(/quote|reservation|cost|exceed/i);expect(x.storage.getBrowserTicket(t.ticketId)?.status).toBe("ISSUED");}finally{x.storage.close();}});
 it("renews one expired unclaimed ticket on the same attempt without reserving budget again",async()=>{const x=await setup();try{const old=await x.engine.prepareUserResumeRetry(x.job.id,x.fresh,x.proofPath,x.authPath);x.storage.db.prepare("update browser_execution_tickets set issued_at=? where id=?").run(new Date(Date.now()-61_000).toISOString(),old.ticketId);const before=x.storage.getBudgetLedger("run"),renewed=x.engine.renewUnclaimedBrowserTicket(old.ticketId,observation("new"));expect(renewed).toMatchObject({attemptId:old.attemptId,action:"GENERATE",status:"ISSUED"});expect(renewed.ticketId).not.toBe(old.ticketId);expect(x.storage.getBrowserTicket(old.ticketId)?.status).toBe("EXPIRED");expect(x.storage.getBudgetLedger("run")).toEqual(before);expect(()=>x.engine.claimExistingBrowser(old.ticketId,observation("new"))).toThrow();expect(x.engine.claimExistingBrowser(renewed.ticketId,observation("new"))).toMatchObject({status:"CLAIMED"});}finally{x.storage.close();}});
 it("refuses renewal after claim or when account, quote, or visible assets changed",async()=>{for(const kind of ["claimed","account","quote","asset"]){const x=await setup();try{const old=await x.engine.prepareUserResumeRetry(x.job.id,x.fresh,x.proofPath,x.authPath);x.storage.db.prepare("update browser_execution_tickets set issued_at=? where id=?").run(new Date(Date.now()-61_000).toISOString(),old.ticketId);let fresh=observation("new");if(kind==="claimed")x.storage.claimBrowserTicket(old.ticketId);if(kind==="account")fresh={...fresh,visibleAccountContext:`account-sha256:${"b".repeat(64)}`};if(kind==="quote")fresh=observation("new",11);if(kind==="asset")fresh={...fresh,visibleAssetRefs:[...baseline,"new"]};const before=x.storage.getBudgetLedger("run");expect(()=>x.engine.renewUnclaimedBrowserTicket(old.ticketId,fresh)).toThrow();expect(x.storage.getBudgetLedger("run")).toEqual(before);expect((x.storage.db.prepare("select count(*) n from browser_execution_tickets where attempt_id=?").get(old.attemptId) as any).n).toBe(1);}finally{x.storage.close();}}});
});
