import { execFile } from "node:child_process";
import { mkdtemp,readFile,writeFile } from "node:fs/promises";
import { createHash } from "node:crypto";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { promisify } from "node:util";
import { describe,expect,it } from "vitest";
import { JobEngine } from "../../packages/job-engine/src/index.js";
import { Storage } from "../../packages/storage/src/index.js";
import type { ExistingBrowserObservation, VideoGenerationRequest } from "../../packages/contracts/src/index.js";

const exec=promisify(execFile),fingerprint=`account-sha256:${"a".repeat(64)}`;
function request(key:string,mode:"text_to_video"|"extend_video",directory:string,parent?:{id:string;asset:string}):VideoGenerationRequest{return {provider:"flow_ui",idempotencyKey:key,project:{name:"https://flow.google.com/project/coast",reuse:true},mode,prompt:"fixture",promptMode:"verbatim",model:"Veo 3.1 Lite",modelPolicy:{version:1,requiredFamily:"veo",apiCode:null,allowFallback:false,executionBackend:"flow_ui",selectionSource:"explicit"},aspectRatio:"16:9",durationSeconds:8,resolution:"720p",outputs:1,download:{enabled:true,directory,format:"mp4"},costPolicy:{maxCredits:50,confirmAbove:50,rejectWhenUnknown:true},authorizationContext:{source:"current_conversation",explicitlyRequestedGeneration:true},budgetContext:{ledgerId:"coast-ledger",stepKey:mode==="extend_video"?"step02":"step01"},sourceParentJobId:parent?.id,sourceAssetRef:parent?.asset};}
function observation(mode:"text_to_video"|"extend_video",source:string|null):ExistingBrowserObservation{return {browserId:"browser",tabId:"tab",url:"https://flow.google.com/project/coast",projectRef:"https://flow.google.com/project/coast",observedAt:new Date().toISOString(),configuration:{model:"veo-3.1-lite",modelOption:{label:"Veo 3.1 Lite",value:"veo-3.1-lite"},mode,aspectRatio:"16:9",durationSeconds:8,resolution:"720p",outputs:1},capabilityCapture:{hash:`sha256:${"c".repeat(64)}`,capturedAt:new Date().toISOString(),locale:"en-US",modelOptions:[{label:"Veo 3.1 Lite",value:"veo-3.1-lite"}]},availableCredits:100,totalCredits:10,visibleAccountContext:fingerprint,visibleAssetRefs:["parent-card"],selectedSourceAssetRef:source};}
async function setup(){const dir=await mkdtemp(join(tmpdir(),"flowbridge-extend-")),storage=new Storage(join(dir,"db.sqlite")),engine=new JobEngine(storage,new Map());const parent=await engine.create(request("parent","text_to_video",join(dir,"out")));storage.reserveBudgetStep("coast-ledger","step01",10,{jobId:parent.id,requestHash:parent.requestHash});storage.consumeBudgetStep("coast-ledger","step01");storage.saveAssets(parent.id,[{providerAssetRef:"parent-card",status:"generated"}]);storage.transition(parent.id,"GENERATED");return {dir,storage,engine,parent};}

describe("Extend and trusted existing-browser completion",()=>{
  it("uses the original intent baseline across a post-generation RECONCILE ticket",async()=>{const dir=await mkdtemp(join(tmpdir(),"flowbridge-reconcile-sequence-")),storage=new Storage(join(dir,"db.sqlite")),engine=new JobEngine(storage,new Map());try{const job=await engine.create(request("sequence","text_to_video",join(dir,"out")));const before=observation("text_to_video",null);before.visibleAssetRefs=[];const generate=engine.prepareExistingBrowser(job.id,before);engine.claimExistingBrowser(generate.ticketId,before);engine.receiptExistingBrowser(generate.ticketId,"clicked");const after={...before,observedAt:new Date().toISOString(),visibleAssetRefs:["new-card"]};const reconcile=engine.prepareExistingBrowser(job.id,after);expect(reconcile.action).toBe("RECONCILE");engine.claimExistingBrowser(reconcile.ticketId,after);expect(engine.completeExistingBrowser(reconcile.ticketId,{projectRef:after.projectRef,completedAt:new Date().toISOString(),beforeAssetRefs:[],actual:after.configuration!,assets:[{providerAssetRef:"new-card",status:"generated",observedAt:new Date().toISOString()}]}).state).toBe("GENERATED");}finally{storage.close();}});

  it("rejects a legacy intent whose original baseline was never persisted",async()=>{const dir=await mkdtemp(join(tmpdir(),"flowbridge-reconcile-legacy-")),storage=new Storage(join(dir,"db.sqlite")),engine=new JobEngine(storage,new Map());try{const job=await engine.create(request("legacy","text_to_video",join(dir,"out")));const before=observation("text_to_video",null);before.visibleAssetRefs=[];const generate=engine.prepareExistingBrowser(job.id,before);engine.claimExistingBrowser(generate.ticketId,before);engine.receiptExistingBrowser(generate.ticketId,"clicked");const intent=storage.getIntent(job.id)!;const snapshot=JSON.parse(intent.snapshot_json);delete snapshot.baselineAssetRefs;storage.db.prepare("UPDATE submission_attempts SET snapshot_json=? WHERE id=?").run(JSON.stringify(snapshot),intent.id);const after={...before,observedAt:new Date().toISOString(),visibleAssetRefs:["new-card"]},reconcile=engine.prepareExistingBrowser(job.id,after);engine.claimExistingBrowser(reconcile.ticketId,after);expect(()=>engine.completeExistingBrowser(reconcile.ticketId,{projectRef:after.projectRef,completedAt:new Date().toISOString(),beforeAssetRefs:[],actual:after.configuration!,assets:[{providerAssetRef:"new-card",status:"generated",observedAt:new Date().toISOString()}]})).toThrow(/not persisted|infer/i);}finally{storage.close();}});

  it("recovers one known legacy baseline from a hash-bound append-only source observation",async()=>{const dir=await mkdtemp(join(tmpdir(),"flowbridge-reconcile-attest-")),storage=new Storage(join(dir,"db.sqlite")),engine=new JobEngine(storage,new Map());try{const job=await engine.create(request("attest","text_to_video",join(dir,"out"))),before=observation("text_to_video",null);before.visibleAssetRefs=[];const generate=engine.prepareExistingBrowser(job.id,before);engine.claimExistingBrowser(generate.ticketId,before);engine.receiptExistingBrowser(generate.ticketId,"clicked");const intent=storage.getIntent(job.id)!;const snapshot=JSON.parse(intent.snapshot_json);delete snapshot.baselineAssetRefs;storage.db.prepare("UPDATE submission_attempts SET snapshot_json=? WHERE id=?").run(JSON.stringify(snapshot),intent.id);const source={browserId:before.browserId,tabId:before.tabId,projectRef:before.projectRef,capturedAt:before.observedAt,beforeAssetRefs:[]},sourcePath=join(dir,"original-observation.json");await writeFile(sourcePath,JSON.stringify(source));const sourceHash=createHash("sha256").update(await readFile(sourcePath)).digest("hex"),evidence={requestHash:job.requestHash,projectRef:before.projectRef,browserId:before.browserId,tabId:before.tabId,capturedAt:before.observedAt,sourceObservationPath:sourcePath,sourceObservationSha256:sourceHash,baselineAssetRefs:[],reason:"legacy_mapping_defect" as const};await expect(engine.attestLegacyBaseline(job.id,{...evidence,sourceObservationSha256:"0".repeat(64)})).rejects.toThrow(/hash/i);await expect(engine.attestLegacyBaseline(job.id,{...evidence,projectRef:"https://flow.google.com/project/other"})).rejects.toThrow(/match/i);const futurePath=join(dir,"future.json"),future={...source,capturedAt:new Date(Date.now()+60_000).toISOString()};await writeFile(futurePath,JSON.stringify(future));await expect(engine.attestLegacyBaseline(job.id,{...evidence,capturedAt:future.capturedAt,sourceObservationPath:futurePath,sourceObservationSha256:createHash("sha256").update(await readFile(futurePath)).digest("hex")})).rejects.toThrow(/before|60 seconds/i);expect(await engine.attestLegacyBaseline(job.id,evidence)).toMatchObject({attested:true,baselineAssetRefs:[]});await expect(engine.attestLegacyBaseline(job.id,evidence)).rejects.toThrow(/already|replace/i);const after={...before,observedAt:new Date().toISOString(),visibleAssetRefs:["new-card"]},reconcile=engine.prepareExistingBrowser(job.id,after);engine.claimExistingBrowser(reconcile.ticketId,after);expect(engine.completeExistingBrowser(reconcile.ticketId,{projectRef:after.projectRef,completedAt:new Date().toISOString(),beforeAssetRefs:[],actual:after.configuration!,assets:[{providerAssetRef:"new-card",status:"generated",observedAt:new Date().toISOString()}]}).state).toBe("GENERATED");}finally{storage.close();}});

  it("accepts a contemporaneous tool-log baseline only in intent-observe-Approve-receipt order",async()=>{const dir=await mkdtemp(join(tmpdir(),"flowbridge-reconcile-tool-log-")),storage=new Storage(join(dir,"db.sqlite")),engine=new JobEngine(storage,new Map());try{const job=await engine.create(request("tool-log","text_to_video",join(dir,"out"))),before=observation("text_to_video",null);before.visibleAssetRefs=[];const generate=engine.prepareExistingBrowser(job.id,before);engine.claimExistingBrowser(generate.ticketId,before);engine.receiptExistingBrowser(generate.ticketId,"clicked");const intent=storage.getIntent(job.id)!;const snapshot=JSON.parse(intent.snapshot_json);delete snapshot.baselineAssetRefs;storage.db.prepare("UPDATE submission_attempts SET snapshot_json=? WHERE id=?").run(JSON.stringify(snapshot),intent.id);const base=Date.parse(intent.intent_recorded_at),capturedAt=new Date(base+100).toISOString(),approveAt=new Date(base+200).toISOString(),receiptAt=new Date(base+300).toISOString();storage.db.prepare("UPDATE browser_execution_tickets SET receipt_json=? WHERE id=?").run(JSON.stringify({outcome:"clicked",receivedAt:receiptAt}),generate.ticketId);const source={recordType:"contemporaneous_tool_log" as const,sourceThreadId:"thread-fixture",sourceItemId:"call-read",sourceRolloutOrdinal:2806,sourceLine:42,approveItemId:"call-approve",approveAt,browserId:before.browserId,tabId:before.tabId,projectRef:before.projectRef,capturedAt,beforeAssetRefs:[]},sourcePath=join(dir,"tool-log-export.json");await writeFile(sourcePath,JSON.stringify(source));const evidence={...source,requestHash:job.requestHash,sourceObservationPath:sourcePath,sourceObservationSha256:createHash("sha256").update(await readFile(sourcePath)).digest("hex"),baselineAssetRefs:[],reason:"legacy_mapping_defect" as const};await expect(engine.attestLegacyBaseline(job.id,{...evidence,approveAt:new Date(base+50).toISOString()})).rejects.toThrow(/ordered|before/i);expect(await engine.attestLegacyBaseline(job.id,evidence)).toMatchObject({attested:true,baselineAssetRefs:[]});}finally{storage.close();}});

  it("binds Extend to the unique parent asset and completes only a claimed, uniquely attributed card",async()=>{const x=await setup();try{const child=await x.engine.create(request("extend","extend_video",join(x.dir,"out"),{id:x.parent.id,asset:"parent-card"}));const obs=observation("extend_video","parent-card");const ticket=x.engine.prepareExistingBrowser(child.id,obs);expect(ticket.action).toBe("GENERATE");expect(x.storage.getIntent(child.id)).not.toBeNull();x.engine.claimExistingBrowser(ticket.ticketId,obs);const complete=x.engine.completeExistingBrowser(ticket.ticketId,{projectRef:obs.projectRef,completedAt:new Date().toISOString(),beforeAssetRefs:["parent-card"],actual:{...obs.configuration!,selectedSourceAssetRef:"parent-card",outputKind:"continuation",actualDurationSeconds:8},assets:[{providerAssetRef:"extend-card",status:"generated",observedAt:new Date().toISOString(),outputKind:"continuation",actualDurationSeconds:8}]});expect(complete.state).toBe("GENERATED");expect(complete.assets).toHaveLength(1);expect(x.storage.getBudgetStep("coast-ledger","step02")?.state).toBe("CONSUMED");expect(()=>x.engine.completeExistingBrowser(ticket.ticketId,{projectRef:obs.projectRef,completedAt:new Date().toISOString(),beforeAssetRefs:["parent-card"],actual:obs.configuration!,assets:[]})).toThrow(/claimed|consumed/i);}finally{x.storage.close();}});

  it("rejects a different selected source before reserving intent or step02",async()=>{const x=await setup();try{const child=await x.engine.create(request("bad-source","extend_video",join(x.dir,"out"),{id:x.parent.id,asset:"parent-card"}));expect(()=>x.engine.prepareExistingBrowser(child.id,observation("extend_video","other-card"))).toThrow(/source/i);expect(x.storage.getIntent(child.id)).toBeNull();expect(x.storage.getBudgetStep("coast-ledger","step02")).toBeNull();}finally{x.storage.close();}});

  it("rejects baseline substitution and requires audio during real-browser download ingest",async()=>{const x=await setup();try{const child=await x.engine.create(request("evidence","extend_video",join(x.dir,"out"),{id:x.parent.id,asset:"parent-card"}));const obs=observation("extend_video","parent-card"),ticket=x.engine.prepareExistingBrowser(child.id,obs);x.engine.claimExistingBrowser(ticket.ticketId,obs);const evidence={projectRef:obs.projectRef,completedAt:new Date().toISOString(),beforeAssetRefs:["parent-card"],actual:{...obs.configuration!,selectedSourceAssetRef:"parent-card",outputKind:"continuation" as const,actualDurationSeconds:8},assets:[{providerAssetRef:"extend-card",status:"generated" as const,observedAt:new Date().toISOString(),outputKind:"continuation" as const,actualDurationSeconds:8}]};expect(()=>x.engine.completeExistingBrowser(ticket.ticketId,{...evidence,beforeAssetRefs:[]})).toThrow(/baseline/i);x.engine.completeExistingBrowser(ticket.ticketId,evidence);const silent=join(x.dir,"silent.mp4");await exec("ffmpeg",["-y","-v","error","-f","lavfi","-i","color=c=blue:s=1280x720:r=24:d=8","-c:v","libx264","-pix_fmt","yuv420p",silent]);const hash=createHash("sha256").update(await readFile(silent)).digest("hex");await expect(x.engine.ingestExistingBrowserDownload(child.id,"extend-card",silent,{jobId:child.id,providerAssetRef:"extend-card",projectRef:obs.projectRef,downloadedAt:new Date().toISOString(),sourceSha256:hash})).rejects.toMatchObject({code:"DOWNLOAD_FAILED"});expect(x.engine.get(child.id).state).toBe("DOWNLOAD_FAILED");}finally{x.storage.close();}});

  it("persists a uniquely attributed native MP4 only after probe, audio and full decode",async()=>{const x=await setup();try{const child=await x.engine.create(request("download","extend_video",join(x.dir,"out"),{id:x.parent.id,asset:"parent-card"}));const obs=observation("extend_video","parent-card"),ticket=x.engine.prepareExistingBrowser(child.id,obs);x.engine.claimExistingBrowser(ticket.ticketId,obs);x.engine.completeExistingBrowser(ticket.ticketId,{projectRef:obs.projectRef,completedAt:new Date().toISOString(),beforeAssetRefs:["parent-card"],actual:{...obs.configuration!,selectedSourceAssetRef:"parent-card",outputKind:"continuation",actualDurationSeconds:8},assets:[{providerAssetRef:"extend-card",status:"generated",observedAt:new Date().toISOString(),outputKind:"continuation",actualDurationSeconds:8}]});const source=join(x.dir,"native.mp4");await exec("ffmpeg",["-y","-v","error","-f","lavfi","-i","color=c=green:s=1280x720:r=24:d=8","-f","lavfi","-i","sine=frequency=440:sample_rate=48000:duration=8","-shortest","-c:v","libx264","-pix_fmt","yuv420p","-c:a","aac",source]);const hash=createHash("sha256").update(await readFile(source)).digest("hex");const done=await x.engine.ingestExistingBrowserDownload(child.id,"extend-card",source,{jobId:child.id,providerAssetRef:"extend-card",projectRef:obs.projectRef,downloadedAt:new Date().toISOString(),sourceSha256:hash});expect(done.state).toBe("COMPLETED");expect(done.assets?.[0]).toMatchObject({providerAssetRef:"extend-card",localPath:expect.stringMatching(/\.mp4$/),sha256:expect.stringMatching(/^[a-f0-9]{64}$/),metadata:{fullDecode:{ok:true}}});}finally{x.storage.close();}});

  it("allows a frozen first-frame continuation while retaining the parent asset and ledger binding",async()=>{const x=await setup();try{const frame=join(x.dir,"parent-last-frame.png");await writeFile(frame,"fixture-frame-bytes");const childRequest=request("first-frame","text_to_video",join(x.dir,"out"),{id:x.parent.id,asset:"parent-card"});childRequest.mode="first_frame_to_video";childRequest.budgetContext!.stepKey="step02";childRequest.inputs={firstFrame:{path:frame}};const child=await x.engine.create(childRequest);const obs=observation("text_to_video",null);obs.configuration={...obs.configuration!,mode:"first_frame_to_video"};const ticket=x.engine.prepareExistingBrowser(child.id,obs);expect(ticket.action).toBe("GENERATE");expect(JSON.parse(x.storage.getRequestJson(child.id))).toMatchObject({sourceParentJobId:x.parent.id,sourceAssetRef:"parent-card",inputs:{firstFrame:{contentSha256:expect.stringMatching(/^[a-f0-9]{64}$/)}}});}finally{x.storage.close();}});
});
